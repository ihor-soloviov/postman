# Пароль для входу (єдиний користувач)
APP_PASSWORD=change-me

# Секрет для підпису cookie. Згенеруй: openssl rand -hex 32
SECRET_KEY=change-me-too

# Ключ OpenRouteService. Можна лишити порожнім і вписати в самій апці,
# на вкладці "Налаштування". https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Де лежить база (SQLite). Відносний шлях — від кореня проєкту.
DB_PATH=data/postman.db

PORT=3000
